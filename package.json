{
  "name": "@quilt/fleet",
  "version": "0.1.0",
  "description": "Fleet orchestrator for Quilt instances across tiers (ESP32, Jetson, Codespace, Cloudflare, Server)",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "quilt-fleet": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@quilt/core": "^0.1.0",
    "@quilt/sdk": "^0.1.0",
    "axios": "^1.6.0",
    "bonjour-service": "^1.2.0",
    "express": "^4.18.0",
    "ioredis": "^5.3.0",
    "mqtt": "^5.3.0",
    "nats": "^2.20.0",
    "ws": "^8.16.0",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "eslint": "^10.8.1",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "quilt",
    "fleet",
    "orchestration",
    "federation",
    "esp32",
    "jetson",
    "cloudflare",
    "iot",
    "edge",
    "mesh"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperInstance/quilt-fleet.git"
  },
  "author": "SuperInstance <dev@superinstance.ai>",
  "homepage": "https://github.com/SuperInstance/quilt-fleet#readme"
}
